# Change all secrets before deployment. Do not commit .env.
MYSQL_PASSWORD=replace_with_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
DATABASE_URL=mysql+pymysql://roomtask:replace_with_long_random_password@db:3306/roomtask

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:8088

# Discord bot (optional; enable with --profile discord)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
# Read-only status board channel (create this channel manually in Discord)
DISCORD_BOARD_CHANNEL_ID=
# Use the same long random secret in API and bot configuration
DISCORD_BOARD_API_KEY=
DISCORD_BOARD_REFRESH_SECONDS=60

# Optional Discord channel webhook for completed-ticket notifications
DISCORD_WEBHOOK_URL=
